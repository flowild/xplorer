<Window x:Class="Xplorer.SearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Search" Width="780" Height="520" MinWidth="500" MinHeight="300" WindowStartupLocation="CenterOwner">
    <DockPanel Margin="12">
        <TextBlock x:Name="Scope" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8" />
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <Button DockPanel.Dock="Right" Content="Stop" Click="Stop_Click" Padding="12,4" Margin="6,0,0,0" />
            <Button DockPanel.Dock="Right" Content="Search" Click="Search_Click" Padding="12,4" Margin="6,0,0,0" />
            <TextBox x:Name="Query" Padding="6,4" KeyDown="Query_KeyDown" ToolTip="Search file and folder names" />
        </DockPanel>
        <TextBox x:Name="SearchStatus" DockPanel.Dock="Bottom" IsReadOnly="True" BorderThickness="0" Background="Transparent" TextWrapping="Wrap" Margin="0,8,0,0" />
        <Button DockPanel.Dock="Bottom" Content="Open containing folder" Click="OpenLocation_Click" HorizontalAlignment="Right" Margin="0,8,0,0" Padding="12,4" />
        <ListView x:Name="Results" MouseDoubleClick="Results_DoubleClick" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
            <ListView.View><GridView>
                <GridViewColumn Header="Name" DisplayMemberBinding="{Binding Name}" Width="220" />
                <GridViewColumn Header="Path" DisplayMemberBinding="{Binding Path}" Width="480" />
            </GridView></ListView.View>
        </ListView>
    </DockPanel>
</Window>
