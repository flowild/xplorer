<Window x:Class="Xplorer.WinUI.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Xplorer (WinUI prototype)">
  <Grid Padding="12" RowSpacing="8" KeyDown="Root_KeyDown">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TabView x:Name="Tabs" IsAddTabButtonVisible="True" AddTabButtonClick="AddTab_Click" TabCloseRequested="TabClose_Click" SelectionChanged="TabSelection_Changed" />
    <Grid Grid.Row="1" ColumnSpacing="4">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Button Content="←" Click="Back_Click" ToolTipService.ToolTip="Back" AutomationProperties.Name="Back"/>
      <Button Grid.Column="1" Content="→" Click="Forward_Click" ToolTipService.ToolTip="Forward" AutomationProperties.Name="Forward"/>
      <Button Grid.Column="2" Content="↑" Click="Up_Click" ToolTipService.ToolTip="Parent folder" AutomationProperties.Name="Parent folder"/>
      <Grid Grid.Column="3" ColumnSpacing="2">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <ScrollViewer x:Name="BreadcrumbView" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><StackPanel x:Name="Breadcrumbs" Orientation="Horizontal" Spacing="2"/></ScrollViewer>
        <TextBox x:Name="Address" Visibility="Collapsed" KeyDown="Address_KeyDown" LostFocus="Address_LostFocus" PlaceholderText="Enter a folder path" AutomationProperties.Name="Address"/>
        <Button Grid.Column="1" Content="✎" Click="EditAddress_Click" ToolTipService.ToolTip="Edit address (Ctrl+L)" AutomationProperties.Name="Edit address"/>
      </Grid>
      <Button Grid.Column="4" Content="⟳" Click="Refresh_Click" ToolTipService.ToolTip="Refresh" AutomationProperties.Name="Refresh"/>
      <Button Grid.Column="5" Content="⚙" ToolTipService.ToolTip="Settings" AutomationProperties.Name="Settings">
        <Button.Flyout><Flyout><StackPanel Spacing="8" MinWidth="240"><TextBlock Text="Settings" FontWeight="SemiBold"/><CheckBox x:Name="FolderSizes" Content="Calculate folder sizes" Click="FolderSizes_Click"/><CheckBox x:Name="ShowHiddenItems" Content="Show hidden items" Click="ShowHiddenItems_Click"/><TextBlock Text="Sizes are calculated in the background." TextWrapping="Wrap" Opacity="0.7"/></StackPanel></Flyout></Button.Flyout>
      </Button>
    </Grid>
    <Grid Grid.Row="2" ColumnSpacing="0">
      <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="200" MinWidth="140" MaxWidth="400"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <ScrollViewer><StackPanel Spacing="4">
        <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="FAVORITES" FontWeight="SemiBold"/><Button Content="+" Click="AddFavorite_Click" ToolTipService.ToolTip="Add current folder" /></StackPanel>
        <StackPanel x:Name="Favorites" />
        <TextBlock Text="PLACES" FontWeight="SemiBold" Margin="0,12,0,4"/>
        <StackPanel x:Name="Places" />
        <Button Content="Drives" Click="Drives_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,12,0,4"/>
        <StackPanel x:Name="Drives" />
        <Button Content="Refresh drives" Click="RefreshDrives_Click"/>
      </StackPanel></ScrollViewer>
      <Thumb Grid.Column="1" x:Name="SidebarSplitter" DragDelta="SidebarSplitter_DragDelta" DragCompleted="SidebarSplitter_DragCompleted" KeyDown="SidebarSplitter_KeyDown" IsTabStop="True" Background="{ThemeResource SystemControlForegroundBaseLowBrush}" ToolTipService.ToolTip="Drag to resize sidebar" AutomationProperties.Name="Resize sidebar" />
      <Grid Grid.Column="2" RowSpacing="4" Margin="8,0,0,0">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid ColumnSpacing="6"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <DropDownButton Content="New" AutomationProperties.Name="New"><DropDownButton.Flyout><MenuFlyout><MenuFlyoutItem Text="New folder" Click="NewFolder_Click"/><MenuFlyoutItem Text="New file" Click="NewFile_Click"/></MenuFlyout></DropDownButton.Flyout></DropDownButton>
          <DropDownButton Grid.Column="1" Content="Actions" AutomationProperties.Name="Actions"><DropDownButton.Flyout><MenuFlyout>
            <MenuFlyoutItem Text="Copy" Click="Copy_Click"/><MenuFlyoutItem Text="Cut" Click="Cut_Click"/><MenuFlyoutItem Text="Paste" Click="Paste_Click"/><MenuFlyoutSeparator/>
            <MenuFlyoutItem Text="Rename" Click="Rename_Click"/><MenuFlyoutItem Text="Delete" Click="Delete_Click"/><MenuFlyoutSeparator/>
            <MenuFlyoutItem Text="Select all" Click="SelectAll_Click"/><MenuFlyoutItem Text="Clear selection" Click="ClearSelection_Click"/><MenuFlyoutItem Text="Invert selection" Click="InvertSelection_Click"/>
          </MenuFlyout></DropDownButton.Flyout></DropDownButton>
          <TextBox Grid.Column="2" x:Name="SearchQuery" PlaceholderText="Search this folder" KeyDown="SearchQuery_KeyDown" MinWidth="100"/>
          <Button Grid.Column="3" Content="⌕" Click="Search_Click" AutomationProperties.Name="Search" ToolTipService.ToolTip="Search"/>
          <Button Grid.Column="4" Content="■" Click="StopSearch_Click" AutomationProperties.Name="Stop" ToolTipService.ToolTip="Stop search"/>
          <Button Grid.Column="5" Content="×" Click="ClearSearch_Click" AutomationProperties.Name="Clear" ToolTipService.ToolTip="Return to folder"/>
        </Grid>
        <Grid Grid.Row="2" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/><ColumnDefinition Width="130"/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions>
          <Button x:Name="SortName" Content="Name" Tag="Name" Click="Sort_Click" HorizontalAlignment="Stretch"/><Button Grid.Column="1" x:Name="SortType" Content="Type" Tag="Type" Click="Sort_Click" HorizontalAlignment="Stretch"/><Button Grid.Column="2" x:Name="SortSize" Content="Size" Tag="Size" Click="Sort_Click" HorizontalAlignment="Stretch"/><Button Grid.Column="3" x:Name="SortModified" Content="Modified" Tag="Modified" Click="Sort_Click" HorizontalAlignment="Stretch"/>
        </Grid>
        <ListView x:Name="Files" Grid.Row="3" SelectionMode="Extended" SelectionChanged="Files_SelectionChanged" DoubleTapped="Files_DoubleTapped" RightTapped="Files_RightTapped" KeyDown="Files_KeyDown">
          <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style></ListView.ItemContainerStyle>
          <ListView.ItemTemplate><DataTemplate><Grid ColumnSpacing="8" ToolTipService.ToolTip="{Binding Path}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/><ColumnDefinition Width="130"/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}"/><TextBlock Grid.Column="1" Text="{Binding Type}"/><TextBlock Grid.Column="2" Text="{Binding Size}" ToolTipService.ToolTip="{Binding SizeDetail}"/><TextBlock Grid.Column="3" Text="{Binding Modified}"/></Grid></DataTemplate></ListView.ItemTemplate>
        </ListView>
      </Grid>
    </Grid>
    <Grid Grid.Row="3" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="Status" IsReadOnly="True" TextWrapping="Wrap"/><TextBlock x:Name="SelectionStatus" Grid.Column="1" Text="0 selected" VerticalAlignment="Center"/></Grid>
  </Grid>
</Window>
