<Window x:Class="Xplorer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Xplorer" Height="650" Width="1000" MinHeight="350" MinWidth="600" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <DataTemplate x:Key="SidebarItemTemplate">
            <Button Content="{Binding Name}" Tag="{Binding Path}" ToolTip="{Binding Path}"
                    Click="SidebarItem_Click" HorizontalContentAlignment="Left" Padding="8,6" Margin="0,1" />
        </DataTemplate>
        <Style x:Key="TabItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="0,0,3,0" />
            <Setter Property="Background" Value="#E7EBF1" />
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="TabBorder" Background="{TemplateBinding Background}" CornerRadius="8,8,0,0" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="#D9E3F1" /></Trigger>
                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="White" /><Setter Property="FontWeight" Value="SemiBold" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value>
            </Setter>
            <EventSetter Event="PreviewMouseDown" Handler="Tab_PreviewMouseDown" />
            <Setter Property="ToolTip" Value="Middle-click to close tab" />
        </Style>
    </Window.Resources>
    <DockPanel Margin="12">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <Button DockPanel.Dock="Right" Content="+" ToolTip="New tab (Ctrl+T)" Click="NewTab_Click" Padding="10,3" />
            <ListBox x:Name="Tabs" SelectionChanged="Tabs_SelectionChanged" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource TabItemStyle}" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ListBox.ItemsPanel>
                <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Title}" VerticalAlignment="Center" Margin="8,3" /></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
        <TextBox x:Name="Status" DockPanel.Dock="Bottom" Margin="0,8,0,0" IsReadOnly="True"
                 BorderThickness="0" Background="Transparent" TextWrapping="Wrap" />
        <CheckBox x:Name="FolderSizes" DockPanel.Dock="Top" Content="Calculate folder sizes" IsChecked="True" Margin="0,0,0,8" Click="FolderSizes_Click" />
        <ScrollViewer DockPanel.Dock="Top" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,8">
          <StackPanel Orientation="Horizontal">
            <Button Content="⌂" FontSize="16" Padding="8,2" Margin="0,0,6,0" ToolTip="Show drives" AutomationProperties.Name="Show drives" Click="ShowDrives_Click" />
            <ItemsControl x:Name="Breadcrumbs">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate><DataTemplate>
                    <StackPanel Orientation="Horizontal"><Button Content="{Binding Name}" Tag="{Binding Path}" ToolTip="{Binding Path}" Click="SidebarItem_Click" Padding="6,3" /><TextBlock Text=" › " VerticalAlignment="Center" /></StackPanel>
                </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <Button DockPanel.Dock="Right" Content="Search" ToolTip="Search this folder" Click="Search_Click" Margin="8,0,0,0" Padding="12,4" />
            <Button x:Name="BackButton" Content="←" Width="36" Margin="0,0,4,0" Click="Back_Click" ToolTip="Back" IsEnabled="False" />
            <Button x:Name="ForwardButton" Content="→" Width="36" Margin="0,0,4,0" Click="Forward_Click" ToolTip="Forward" IsEnabled="False" />
            <Button Content="↑" Width="36" Margin="0,0,8,0" Click="Up_Click" ToolTip="Parent folder" />
            <Button Content="⟳" Width="36" Margin="0,0,8,0" Click="Refresh_Click" ToolTip="Refresh (F5)" AutomationProperties.Name="Refresh" />
            <Button Content="Open" DockPanel.Dock="Right" Margin="8,0,0,0" Padding="12,4" Click="Go_Click" />
            <TextBox x:Name="Address" Padding="6,4" KeyDown="Address_KeyDown" ToolTip="Enter a folder path" />
        </DockPanel>
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <DockPanel Grid.Column="0" Margin="0,0,12,0">
            <Button DockPanel.Dock="Bottom" Content="Refresh drives" Click="RefreshDrives_Click" Margin="0,8,0,0" Padding="6,4" />
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel>
                <DockPanel Margin="6,4,0,6">
                  <Button DockPanel.Dock="Right" Content="+" ToolTip="Add current folder to favorites" Click="AddFavorite_Click" Padding="5,0" />
                  <TextBlock Text="FAVORITES" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
                <ItemsControl x:Name="FavoritesList">
                  <ItemsControl.ItemTemplate><DataTemplate>
                    <DockPanel>
                      <Button DockPanel.Dock="Right" Content="×" ToolTip="Remove favorite" Tag="{Binding Path}" Click="RemoveFavorite_Click" Padding="5,0" />
                      <Button Content="{Binding Name}" Tag="{Binding Path}" ToolTip="{Binding Path}" Click="SidebarItem_Click" HorizontalContentAlignment="Left" Padding="8,6" Margin="0,1" />
                    </DockPanel>
                  </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="PLACES" FontWeight="SemiBold" Margin="6,4,0,6" />
                <ItemsControl x:Name="PlacesList" ItemTemplate="{StaticResource SidebarItemTemplate}" />
                <TextBlock Text="DRIVES" FontWeight="SemiBold" Margin="6,16,0,6" />
                <ItemsControl x:Name="DrivesList" ItemTemplate="{StaticResource SidebarItemTemplate}" />
                <TextBlock x:Name="DrivesStatus" Margin="6,4" TextWrapping="Wrap" />
              </StackPanel>
            </ScrollViewer>
          </DockPanel>
        <ListView Grid.Column="1" x:Name="FileList" MouseDoubleClick="FileList_DoubleClick" KeyDown="FileList_KeyDown" SelectionMode="Extended"
                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                  ScrollViewer.CanContentScroll="True" GridViewColumnHeader.Click="ColumnHeader_Click">
            <ListView.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="New folder" Click="NewFolder_Click" />
                    <MenuItem Header="New file" Click="NewFile_Click" />
                    <Separator />
                    <MenuItem Header="Paste" InputGestureText="Ctrl+V" Click="Paste_Click" />
                </ContextMenu>
            </ListView.ContextMenu>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <EventSetter Event="PreviewMouseRightButtonDown" Handler="Item_RightButtonDown" />
                    <EventSetter Event="ContextMenuOpening" Handler="Item_ContextMenuOpening" />
                    <Setter Property="ContextMenu"><Setter.Value><ContextMenu /></Setter.Value></Setter>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.View>
                <GridView>
                    <GridViewColumn DisplayMemberBinding="{Binding Name}" Width="350"><GridViewColumn.Header><GridViewColumnHeader Content="Name ↑" Tag="Name" /></GridViewColumn.Header></GridViewColumn>
                    <GridViewColumn DisplayMemberBinding="{Binding Type}" Width="130"><GridViewColumn.Header><GridViewColumnHeader Content="Type" Tag="Type" /></GridViewColumn.Header></GridViewColumn>
                    <GridViewColumn Width="150">
                        <GridViewColumn.Header><GridViewColumnHeader Content="Size" Tag="Size" /></GridViewColumn.Header>
                        <GridViewColumn.CellTemplate><DataTemplate>
                            <TextBlock Text="{Binding Size}" ToolTip="{Binding SizeDetail}" />
                        </DataTemplate></GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn DisplayMemberBinding="{Binding Modified}" Width="160"><GridViewColumn.Header><GridViewColumnHeader Content="Modified" Tag="Modified" /></GridViewColumn.Header></GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>
        </Grid>
    </DockPanel>
</Window>
